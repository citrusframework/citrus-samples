<test name="TodoListBasicAuthHeader" author="Citrus" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <actions>
    <http client="todoClient">
      <send-request>
        <GET path="/todo/" accept="application/xml">
          <headers>
            <header name="Authorization" value="Basic citrus:encodeBase64('citrus:secr3t')"/>
          </headers>
        </GET>
      </send-request>
    </http>
    <http client="todoClient">
      <receive-response>
        <response status="200"/>
      </receive-response>
    </http>
  </actions>
</test>
