<test name="TodoListLoadAddTodo" author="Citrus" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <actions>
    <http client="todoClient">
      <send-request>
        <POST path="/todolist" content-type="application/x-www-form-urlencoded">
          <body>
            <data><![CDATA[title=citrus:concat('todo_', citrus:randomNumber(10))]]></data>
          </body>
        </POST>
      </send-request>
    </http>
    <http client="todoClient">
      <receive-response>
        <response status="200"/>
      </receive-response>
    </http>
  </actions>
</test>
