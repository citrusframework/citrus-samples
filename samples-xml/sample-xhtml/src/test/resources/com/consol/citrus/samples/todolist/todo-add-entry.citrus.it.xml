<test name="TodoAddTodoEntryIT" author="Christoph Deppisch" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase https://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Add todo entry via form</description>
  <variables>
    <variable name="todoName" value="citrus:concat('todo_', citrus:randomNumber(4))"/>
    <variable name="todoDescription" value="Description: ${todoName}"/>
  </variables>
  <actions>
    <http client="todoClient">
      <send-request>
        <POST path="/todolist" content-type="application/x-www-form-urlencoded">
          <body>
            <data>title=${todoName}&amp;description=${todoDescription}</data>
          </body>
        </POST>
      </send-request>
    </http>
    <http client="todoClient">
      <receive-response>
        <response status="200"/>
      </receive-response>
    </http>
    <http client="todoClient">
      <send-request>
        <GET path="/todolist" accept="text/html"/>
      </send-request>
    </http>
    <http client="todoClient">
      <receive-response>
        <response status="200" type="XHTML"/>
        <validate>
          <xpath expression="(//xh:li[@class='list-group-item']/xh:span)[last()]" value="${todoName}"/>
        </validate>
      </receive-response>
    </http>
  </actions>
</test>
