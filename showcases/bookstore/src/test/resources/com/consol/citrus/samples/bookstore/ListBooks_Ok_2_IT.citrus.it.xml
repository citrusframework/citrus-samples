<test name="ListBooks_Ok_2_IT.xml" author="Christoph Deppisch" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Add random book then validate presence via Groovy script.</description>
  <variables>
    <variable name="isbn" value="citrus:concat('978-', citrus:randomNumber(9, true))"/>
    <variable name="year" value="citrus:currentDate('yyyy')"/>
  </variables>
  <actions>
    <soap client="bookStoreClient">
      <send-request>
        <message soap-action="addBook">
          <body>
            <data><![CDATA[<bkr:AddBookRequestMessage xmlns:bkr="http://www.consol.com/schemas/bookstore"><bkr:book><bkr:title>Random Book</bkr:title><bkr:author>Random Author</bkr:author><bkr:isbn>${isbn}</bkr:isbn><bkr:year>${year}</bkr:year></bkr:book></bkr:AddBookRequestMessage>]]></data>
          </body>
        </message>
      </send-request>
    </soap>
    <soap client="bookStoreClient">
      <receive-response>
        <message>
          <body>
            <data><![CDATA[<bkr:AddBookResponseMessage xmlns:bkr="http://www.consol.com/schemas/bookstore"><bkr:success>true</bkr:success></bkr:AddBookResponseMessage>]]></data>
          </body>
        </message>
      </receive-response>
    </soap>
    <soap client="bookStoreClient">
      <send-request>
        <message soap-action="listBooks">
          <body>
            <data><![CDATA[<bkr:ListBooksRequestMessage xmlns:bkr="http://www.consol.com/schemas/bookstore"/>]]></data>
          </body>
        </message>
      </send-request>
    </soap>
    <soap client="bookStoreClient">
      <receive-response>
        <message/>
        <validate>
          <script type="groovy">org.testng.Assert.assertTrue(root.books.book.findAll{ it.isbn == '${isbn}' }.size() == 1, "Missing book with isbn: '${isbn}' in book list!")</script>
        </validate>
      </receive-response>
    </soap>
  </actions>
</test>
