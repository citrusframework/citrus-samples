<test name="GreetingJms_IT.xml" author="Christoph Deppisch" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Send asynchronous greeting request via JMS: Citrus -&gt; GreetingService</description>
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <send endpoint="greetingJmsRequestSender">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<tns:GreetingRequestMessage xmlns:tns="http://www.citrusframework.org/samples/greeting"><tns:CorrelationId>${correlationId}</tns:CorrelationId><tns:Operation>sayHello</tns:Operation><tns:User>${user}</tns:User><tns:Text>Hello Citrus!</tns:Text></tns:GreetingRequestMessage>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="greetingJmsResponseReceiver">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<tns:GreetingResponseMessage xmlns:tns="http://www.citrusframework.org/samples/greeting"><tns:CorrelationId>${correlationId}</tns:CorrelationId><tns:Operation>sayHello</tns:Operation><tns:User>GreetingService</tns:User><tns:Text>Hello ${user}!</tns:Text></tns:GreetingResponseMessage>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
