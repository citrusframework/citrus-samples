<test name="TodoListIT.testAddTodoEntryBinaryBase64.xml" author="Christoph Deppisch" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>TodoListIT.testAddTodoEntryBinaryBase64 port</description>
  <variables>
    <variable name="todoName" value="citrus:concat('todo_', citrus:randomNumber(4))"/>
    <variable name="todoDescription" value="Description: ${todoName}"/>
    <variable name="done" value="false"/>
  </variables>
  <actions>
    <send endpoint="todoEndpoint">
      <message type="BINARY">
        <headers>
          <header name="_type" value="org.citrusframework.samples.apps.todoapp.model.TodoEntry"/>
        </headers>
        <body>
          <data><![CDATA[{ "title": "${todoName}", "description": "${todoDescription}", "done": ${done}}]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="todoEndpoint">
      <message type="BINARY_BASE64">
        <headers>
          <header name="_type" value="org.citrusframework.samples.apps.todoapp.model.TodoEntry"/>
        </headers>
        <body>
          <data><![CDATA[citrus:encodeBase64('{ "title": "${todoName}", "description": "${todoDescription}", "done": ${done}}')]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
