<test name="TodoPagesIT.testAddEntry.xml" author="Citrus" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>TodoPagesIT.testAddEntry port</description>
  <variables>
    <variable name="todoName" value="todo_citrus:randomNumber(4)"/>
    <variable name="todoDescription" value="Description: ${todoName}"/>
  </variables>
  <actions>
    <http client="todoClient">
      <send-request>
        <DELETE path="/api/todolist"/>
      </send-request>
    </http>
    <http client="todoClient">
      <receive-response>
        <response status="200"/>
      </receive-response>
    </http>
    <playwright browser="browser">
      <start/>
    </playwright>
    <playwright browser="browser">
      <open url="http://localhost:8080/todolist"/>
    </playwright>
    <playwright browser="browser">
      <page-object type="org.citrusframework.samples.connectors.playwright.page.TodoPage" validator="org.citrusframework.samples.connectors.playwright.page.TodoPage$Validator"/>
    </playwright>
    <playwright browser="browser">
      <page-object type="org.citrusframework.samples.connectors.playwright.page.TodoPage" method="submit" arguments="${todoName}, ${todoDescription}"/>
    </playwright>
    <playwright browser="browser">
      <wait condition="visible">
        <element text="${todoName}"/>
      </wait>
    </playwright>
    <playwright browser="browser">
      <verify check="text" expected="${todoName}">
        <element text="${todoName}"/>
      </verify>
    </playwright>
  </actions>
</test>
