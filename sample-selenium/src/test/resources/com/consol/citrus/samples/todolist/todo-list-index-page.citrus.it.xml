<test name="TodoListIT.testIndexPage" author="Christoph Deppisch" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>TodoListIT.testIndexPage port</description>
  <actions>
    <selenium browser="browser">
      <start/>
    </selenium>
    <selenium>
      <navigate page="http://localhost:8080"/>
    </selenium>
    <selenium>
      <find>
        <element link-text="Run application"/>
        <validate enabled="true" displayed="true"/>
      </find>
    </selenium>
    <selenium>
      <click>
        <element link-text="Run application"/>
      </click>
    </selenium>
    <selenium>
      <find>
        <element tag-name="h1"/>
        <validate text="TODO list"/>
      </find>
    </selenium>
  </actions>
</test>
