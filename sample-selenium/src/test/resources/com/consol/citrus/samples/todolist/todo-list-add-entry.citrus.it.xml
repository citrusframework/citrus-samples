<test name="TodoListIT.testAddEntry" author="Christoph Deppisch" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>TodoListIT.testAddEntry port</description>
  <variables>
    <variable name="todoName" value="todo_citrus:randomNumber(4)"/>
    <variable name="todoDescription" value="Description: ${todoName}"/>
  </variables>
  <actions>
    <http client="todoClient">
      <send-request>
        <DELETE path="/api/todolist"/>
      </send-request>
    </http>
    <http client="todoClient">
      <receive-response>
        <response status="200"/>
      </receive-response>
    </http>
    <selenium browser="browser">
      <start/>
    </selenium>
    <selenium>
      <navigate page="http://localhost:8080/todolist"/>
    </selenium>
    <selenium>
      <find>
        <element xpath="(//li[@class='list-group-item'])[last()]"/>
        <validate text="No todos found"/>
      </find>
    </selenium>
    <selenium>
      <set-input value="${todoName}">
        <element name="title"/>
      </set-input>
    </selenium>
    <selenium>
      <set-input value="${todoDescription}">
        <element name="description"/>
      </set-input>
    </selenium>
    <selenium>
      <click>
        <element tag-name="button"/>
      </click>
    </selenium>
    <selenium>
      <wait until="visible" timeout="2000">
        <element xpath="(//li[@class='list-group-item']/span)[last()]"/>
      </wait>
    </selenium>
    <selenium>
      <find>
        <element xpath="(//li[@class='list-group-item']/span)[last()]"/>
        <validate text="${todoName}"/>
      </find>
    </selenium>
  </actions>
</test>
