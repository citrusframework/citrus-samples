<test name="TodoListIT.testReportTodoEntryDone.xml" author="Christoph Deppisch" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>TodoListIT.testReportTodoEntryDone port</description>
  <variables>
    <variable name="todoId" value="citrus:randomUUID()"/>
    <variable name="todoName" value="citrus:concat('todo_', citrus:randomNumber(4))"/>
    <variable name="todoDescription" value="Description: ${todoName}"/>
  </variables>
  <actions>
    <send endpoint="todoJmsEndpoint">
      <message>
        <headers>
          <header name="_type" value="com.consol.citrus.samples.todolist.model.TodoEntry"/>
        </headers>
        <body>
          <data>{ "id": "${todoId}", "title": "${todoName}", "description": "${todoDescription}" }</data>
        </body>
      </message>
    </send>
    <echo message="Set todo entry status to done"/>
    <http client="todoClient">
      <send-request>
        <PUT path="/api/todo/${todoId}" accept="application/json">
          <param name="done" value="true"/>
        </PUT>
      </send-request>
    </http>
    <http client="todoClient">
      <receive-response>
        <response status="200"/>
      </receive-response>
    </http>
    <echo message="Trigger Jms report"/>
    <http client="todoClient">
      <send-request>
        <GET path="/api/jms/report/done" accept="application/json"/>
      </send-request>
    </http>
    <http client="todoClient">
      <receive-response>
        <response status="200"/>
      </receive-response>
    </http>
    <receive endpoint="todoReportEndpoint">
      <message type="JSON">
        <headers>
          <header name="_type" value="com.consol.citrus.samples.todolist.model.TodoEntry"/>
        </headers>
        <body>
          <data>[{ "id": "${todoId}", "title": "${todoName}", "description": "${todoDescription}", "done":true}]</data>
        </body>
      </message>
    </receive>
  </actions>
</test>
