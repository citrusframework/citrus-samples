<test name="NewsFeed_Ok_1_IT" author="Christoph Deppisch" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase">
  <actions>
    <send endpoint="newsJmsEndpoint">
      <message>
        <body>
          <data><![CDATA[<nf:News xmlns:nf="http://citrusframework.org/schemas/samples/news"><nf:Message>Citrus rocks!</nf:Message></nf:News>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="newsServer">
      <message>
        <headers>
          <header name="citrus_soap_action" value="newsFeed"/>
        </headers>
        <body>
          <data><![CDATA[<nf:News xmlns:nf="http://citrusframework.org/schemas/samples/news"><nf:Message>Citrus rocks!</nf:Message></nf:News>]]></data>
        </body>
      </message>
    </receive>
    <send endpoint="newsServer">
      <message>
        <headers>
          <header name="citrus_http_status_code" value="200"/>
        </headers>
      </message>
    </send>
  </actions>
</test>
