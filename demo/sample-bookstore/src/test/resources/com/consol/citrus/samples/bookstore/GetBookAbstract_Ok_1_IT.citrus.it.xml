<test name="GetBookAbstract_Ok_1_IT.xml" author="Christoph Deppisch" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Add book then request book abstract returned as SOAP attachment.</description>
  <variables>
    <variable name="isbn" value="citrus:concat('978-', citrus:randomNumber(10))"/>
  </variables>
  <actions>
    <soap client="bookStoreClient">
      <send-request>
        <message soap-action="addBook">
          <body>
            <data><![CDATA[<bkr:AddBookRequestMessage xmlns:bkr="http://www.consol.com/schemas/bookstore"><bkr:book><bkr:title>Spring in Action</bkr:title><bkr:author>Craig Walls, Ryan Breidenbach</bkr:author><bkr:isbn>${isbn}</bkr:isbn><bkr:year>2007</bkr:year></bkr:book></bkr:AddBookRequestMessage>]]></data>
          </body>
        </message>
      </send-request>
    </soap>
    <soap client="bookStoreClient">
      <receive-response>
        <message>
          <body>
            <data><![CDATA[<bkr:AddBookResponseMessage xmlns:bkr="http://www.consol.com/schemas/bookstore"><bkr:success>true</bkr:success></bkr:AddBookResponseMessage>]]></data>
          </body>
        </message>
      </receive-response>
    </soap>
    <soap client="bookStoreClient">
      <send-request>
        <message soap-action="getBookAbstract">
          <body>
            <data><![CDATA[<bkr:GetBookAbstractRequestMessage xmlns:bkr="http://www.consol.com/schemas/bookstore"><bkr:isbn>${isbn}</bkr:isbn></bkr:GetBookAbstractRequestMessage>]]></data>
          </body>
        </message>
      </send-request>
    </soap>
    <soap client="bookStoreClient">
      <receive-response>
        <message>
          <body>
            <data><![CDATA[<bkr:GetBookAbstractResponseMessage xmlns:bkr="http://www.consol.com/schemas/bookstore"><bkr:book><bkr:id>@ignore@</bkr:id><bkr:title>Spring in Action</bkr:title><bkr:author>Craig Walls, Ryan Breidenbach</bkr:author><bkr:isbn>${isbn}</bkr:isbn><bkr:year>2007</bkr:year><bkr:registration-date>@ignore@</bkr:registration-date></bkr:book></bkr:GetBookAbstractResponseMessage>]]></data>
          </body>
          <attachment content-id="book-abstract" content-type="text/plain">
            <resource file="classpath:com/consol/citrus/samples/bookstore/book-abstract.txt"/>
          </attachment>
        </message>
        <extract>
          <body path="/bkr:GetBookAbstractResponseMessage/bkr:book/bkr:id" variable="bookId"/>
        </extract>
      </receive-response>
    </soap>
  </actions>
</test>
