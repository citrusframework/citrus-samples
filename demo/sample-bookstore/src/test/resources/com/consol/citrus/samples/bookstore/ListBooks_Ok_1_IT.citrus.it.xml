<test name="ListBooks_Ok_1_IT" author="Christoph Deppisch" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Add book then validate it is present in book list via XPath.</description>
  <variables>
    <variable name="isbn" value="citrus:concat('978-', citrus:randomNumber(10))"/>
  </variables>
  <actions>
    <soap client="bookStoreClient">
      <send-request>
        <message soap-action="addBook">
          <body>
            <data><![CDATA[<bkr:AddBookRequestMessage xmlns:bkr="http://www.consol.com/schemas/bookstore"><bkr:book><bkr:title>Enterprise Integration Patterns: Designing, Building, and Deploying Messaging Solutions</bkr:title><bkr:author>Gregor Hohpe, Bobby Wolf</bkr:author><bkr:isbn>${isbn}</bkr:isbn><bkr:year>2003</bkr:year></bkr:book></bkr:AddBookRequestMessage>]]></data>
          </body>
        </message>
      </send-request>
    </soap>
    <soap client="bookStoreClient">
      <receive-response>
        <message>
          <body>
            <data><![CDATA[<bkr:AddBookResponseMessage xmlns:bkr="http://www.consol.com/schemas/bookstore"><bkr:success>true</bkr:success></bkr:AddBookResponseMessage>]]></data>
          </body>
        </message>
      </receive-response>
    </soap>
    <soap client="bookStoreClient">
      <send-request>
        <message soap-action="listBooks">
          <body>
            <data><![CDATA[<bkr:ListBooksRequestMessage xmlns:bkr="http://www.consol.com/schemas/bookstore"/>]]></data>
          </body>
        </message>
      </send-request>
    </soap>
    <soap client="bookStoreClient">
      <receive-response>
        <validate>
          <xpath expression="boolean:count(/bkr:ListBooksResponseMessage/bkr:books/bkr:book) &gt; 0" value="true"/>
          <xpath expression="boolean:/bkr:ListBooksResponseMessage/bkr:books/bkr:book/bkr:isbn[.='${isbn}']" value="true"/>
        </validate>
      </receive-response>
    </soap>
  </actions>
</test>
