<test name="IncidentManager_Jms_SchemaInvalid_IT.xml" author="Christoph Deppisch" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Invalid OpenIncident request via JMS triggers SOAP fault response.</description>
  <actions>
    <send endpoint="incidentJmsEndpoint">
      <message>
        <headers>
          <header name="citrus_soap_action" value="/IncidentManager/openIncident"/>
        </headers>
        <body>
          <data><![CDATA[<im:OpenIncident xmlns:im="http://www.citrusframework.org/schema/samples/IncidentManager/v1"><im:incident><im:captured>@ignore@</im:captured><im:state>NEW</im:state><im:component>SOFTWARE</im:component><im:description>Something missing!</im:description></im:incident></im:OpenIncident>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="incidentJmsEndpoint">
      <message>
        <headers>
          <header name="SOAPJMS_isFault" value="true"/>
        </headers>
        <body>
          <data><![CDATA[<SOAP-ENV:Fault xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/"><faultcode>@contains('Client')@</faultcode><faultstring>@startsWith('Unmarshalling Error')@</faultstring></SOAP-ENV:Fault>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
