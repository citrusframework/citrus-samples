<test name="IncidentManager_Http_SchemaInvalid_IT" author="Christoph Deppisch" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Invalid OpenIncident request triggers SOAP fault with unmarshalling error.</description>
  <actions>
    <soap client="incidentHttpClient">
      <assert-fault fault-code="{http://schemas.xmlsoap.org/soap/envelope/}Client" fault-string="@startsWith('Unmarshalling Error')@">
        <when>
          <send endpoint="incidentHttpClient">
            <message>
              <headers>
                <header name="citrus_soap_action" value="/IncidentManager/openIncident"/>
              </headers>
              <body>
                <data><![CDATA[<im:OpenIncident xmlns:im="http://www.citrusframework.org/schema/samples/IncidentManager/v1"><im:incident><im:captured>@ignore@</im:captured><im:state>NEW</im:state><im:component>SOFTWARE</im:component><im:description>Something missing!</im:description></im:incident></im:OpenIncident>]]></data>
              </body>
            </message>
          </send>
        </when>
      </assert-fault>
    </soap>
  </actions>
</test>
